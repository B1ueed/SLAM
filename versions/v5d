"""
2D Particle Filter SLAM — v5f: Spin Parameter Tuning (Raised Thresholds)
=========================================================================
Adds on top of v3:
  - A* for path planning (once best frontier chosen)
  - Live centroid recomputation every step
  - Information gain scoring: score = info_gain^1.5 / (path_dist+1) * recency
  - Recency penalty (×0.5 per failure) instead of blacklist
  - [REMOVED] Medial axis edge weights in A*
  - Sparse waypoint pruning (keep only direction-change cells, angle > 0.3 rad)
  - Pocket fallback (drop medial axis when ≤3 frontiers remain)
  - Event-driven replan triggers:
      * Centroid drifts > MAX_CENTROID_DRIFT cells
      * Cluster dissolves (< MIN_FRONTIER_SIZE cells remain)
      * Current waypoint blocked by newly-mapped wall
      * Robot stuck > MAX_STUCK_STEPS without progress

NOTE: Medial axis is removed in v4b.
"""

import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec
import heapq
import os

OUTPUT_DIR = 'slam_output'
FRAMES_DIR = os.path.join(OUTPUT_DIR, 'frames')
os.makedirs(FRAMES_DIR, exist_ok=True)

# ─────────────────────────────────────────────────────────────────────────────
# 1.  WORLD
# ─────────────────────────────────────────────────────────────────────────────

WORLD_W = 10.0
WORLD_H =  8.0

WALLS = [
    (0, 0, WORLD_W, 0),
    (WORLD_W, 0, WORLD_W, WORLD_H),
    (WORLD_W, WORLD_H, 0, WORLD_H),
    (0, WORLD_H, 0, 0),
    (3, 0, 3, 4),
    (5, 4, 5, WORLD_H),
    (7, 1, 7, 6),
]

# ─────────────────────────────────────────────────────────────────────────────
# 2.  PARAMETERS
# ─────────────────────────────────────────────────────────────────────────────

N_PARTICLES      = 150
N_BEAMS          = 24
MAX_RANGE        = 8.0

MOTION_NOISE_XY  = 0.05
MOTION_NOISE_TH  = 0.02
SENSOR_NOISE_STD = 0.15

GRID_RES  = 0.25
GRID_COLS = int(WORLD_W / GRID_RES)
GRID_ROWS = int(WORLD_H / GRID_RES)
L_OCC     =  0.85
L_FREE    = -0.40
L_MIN     = -5.0
L_MAX     =  5.0

FREE_THRESH    = -0.1
UNKNOWN_THRESH =  0.1
OCC_THRESH     =  0.5

INFLATION_RADIUS      = 1
MIN_FRONTIER_SIZE     = 3
RECENCY_DECAY         = 0.5
MAX_CENTROID_DRIFT    = 5      # grid cells
# MAX_STUCK_STEPS replaced by MAX_STEPS_PER_WAYPOINT above (v5b)
MERGE_RADIUS          = 5      # grid cells — clusters closer than this get merged
LOCALITY_LAMBDA       = 0.05   # exponential locality decay constant
DIRECTION_WEIGHT      = 2.0    # bonus for frontiers in current travel direction

ROBOT_SPEED   = 0.06          # halved from 0.12 — more lidar observations per metre
                                   # at 0.12 m/step a wall saw 2-3 beams; at 0.06 it gets ~6
ANGULAR_GAIN  = 2.0
ARRIVE_DIST   = 0.3
MAX_STEPS_PER_WAYPOINT = 120  # was 60 — doubled to match halved speed (same effective timeout distance)

# ─────────────────────────────────────────────────────────────────────────────
# 3.  GEOMETRY
# ─────────────────────────────────────────────────────────────────────────────

def ray_segment_intersect(rx, ry, angle, x1, y1, x2, y2):
    dx, dy = np.cos(angle), np.sin(angle)
    wx, wy = x2 - x1, y2 - y1
    denom  = dx * wy - dy * wx
    if abs(denom) < 1e-10:
        return MAX_RANGE
    t = ((x1 - rx) * wy - (y1 - ry) * wx) / denom
    s = ((x1 - rx) * dy - (y1 - ry) * dx) / denom
    if 0 < t < MAX_RANGE and 0 <= s <= 1:
        return t
    return MAX_RANGE

def cast_ray(rx, ry, angle):
    return min(ray_segment_intersect(rx, ry, angle, *w) for w in WALLS)

def take_scan(rx, ry, rtheta, noise_std=0.0):
    angles = rtheta + np.linspace(0, 2*np.pi, N_BEAMS, endpoint=False)
    ranges = np.array([cast_ray(rx, ry, a) for a in angles])
    if noise_std > 0:
        ranges += np.random.normal(0, noise_std, N_BEAMS)
        ranges  = np.clip(ranges, 0, MAX_RANGE)
    return ranges

# ─────────────────────────────────────────────────────────────────────────────
# 4.  OCCUPANCY GRID
# ─────────────────────────────────────────────────────────────────────────────

class OccupancyGrid:
    def __init__(self):
        self.log_odds     = np.zeros((GRID_ROWS, GRID_COLS))
        self.update_counts = np.zeros((GRID_ROWS, GRID_COLS), dtype=np.int32)  # v5a

    def in_bounds(self, r, c):
        return 0 <= r < GRID_ROWS and 0 <= c < GRID_COLS

    def world_to_grid(self, wx, wy):
        return (int(np.clip(wy / GRID_RES, 0, GRID_ROWS-1)),
                int(np.clip(wx / GRID_RES, 0, GRID_COLS-1)))

    def grid_to_world(self, r, c):
        return (c+0.5)*GRID_RES, (r+0.5)*GRID_RES

    def is_free(self, r, c):     return self.log_odds[r, c] <  FREE_THRESH
    def is_unknown(self, r, c):  return FREE_THRESH <= self.log_odds[r, c] <= UNKNOWN_THRESH
    def is_occupied(self, r, c): return self.log_odds[r, c] >  OCC_THRESH

    def update(self, rx, ry, rtheta, scan):
        angles = rtheta + np.linspace(0, 2*np.pi, N_BEAMS, endpoint=False)
        for a, d in zip(angles, scan):
            if d >= MAX_RANGE:
                continue
            n = int(d / GRID_RES)
            for s in range(n):
                r, c = self.world_to_grid(rx + np.cos(a)*s*GRID_RES,
                                           ry + np.sin(a)*s*GRID_RES)
                self.log_odds[r, c] = np.clip(self.log_odds[r,c]+L_FREE, L_MIN, L_MAX)
            r, c = self.world_to_grid(rx + np.cos(a)*d, ry + np.sin(a)*d)
            self.log_odds[r, c] = np.clip(self.log_odds[r,c]+L_OCC, L_MIN, L_MAX)

    def probability_map(self):
        return 1.0 / (1.0 + np.exp(-self.log_odds))

    def build_inflation_mask(self):
        occ  = self.log_odds > OCC_THRESH
        mask = np.zeros_like(occ)
        for r in range(GRID_ROWS):
            for c in range(GRID_COLS):
                if occ[r, c]:
                    for dr in range(-INFLATION_RADIUS, INFLATION_RADIUS+1):
                        for dc in range(-INFLATION_RADIUS, INFLATION_RADIUS+1):
                            nr, nc = r+dr, c+dc
                            if self.in_bounds(nr, nc):
                                mask[nr, nc] = True
        return mask

# ─────────────────────────────────────────────────────────────────────────────
# 5.  PARTICLE FILTER
# ─────────────────────────────────────────────────────────────────────────────

def init_particles(x, y, theta):
    p = np.zeros((N_PARTICLES, 3))
    p[:, 0]=x; p[:, 1]=y; p[:, 2]=theta
    return p

def predict(particles, dx, dy, dtheta):
    particles[:,0] += dx + np.random.normal(0, MOTION_NOISE_XY, N_PARTICLES)
    particles[:,1] += dy + np.random.normal(0, MOTION_NOISE_XY, N_PARTICLES)
    particles[:,2] += dtheta + np.random.normal(0, MOTION_NOISE_TH, N_PARTICLES)
    return particles

def compute_weights(particles, z_actual):
    log_w = np.zeros(N_PARTICLES)
    for i, (px, py, pth) in enumerate(particles):
        z_hat = take_scan(px, py, pth, noise_std=0.0)
        log_w[i] = -0.5 * np.sum((z_actual-z_hat)**2) / SENSOR_NOISE_STD**2
    log_w -= log_w.max()
    w = np.exp(log_w); w /= w.sum()
    return w

def resample(particles, weights):
    N=N_PARTICLES
    pos=(np.arange(N)+np.random.uniform())/N
    cum=np.cumsum(weights)
    return particles[np.searchsorted(cum,pos)].copy()

# ─────────────────────────────────────────────────────────────────────────────
# 6.  [REMOVED] WALL DISTANCE MAP  (medial axis removed in v4b)
